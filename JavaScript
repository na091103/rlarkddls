document.addEventListener('DOMContentLoaded', () => {
  // 1. 검색 기능 인터랙션
  const searchInput = document.getElementById('searchInput');
  const searchBtn = document.getElementById('searchBtn');

  const handleSearch = () => {
    const query = searchInput.value.trim();
    if (query) {
      alert(`'${query}'에 대한 배드민턴 뉴스 및 중계 일정을 검색합니다.`);
      searchInput.value = '';
    } else {
      alert('검색어를 입력해 주세요!');
    }
  };

  searchBtn.addEventListener('click', handleSearch);
  searchInput.addEventListener('keypress', (e) => {
    if (e.key === 'Enter') handleSearch();
  });

  // 2. 경기 일정 버튼 클릭 이벤트
  const matchButtons = document.querySelectorAll('.btn-match');
  matchButtons.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const title = e.target.parentElement.querySelector('h4').innerText;
      alert(`[${title}] 경기 일정 및 알림 설정이 등록되었습니다.`);
    });
  });

  // 3. 인기 선수 클릭 이벤트
  const playerItems = document.querySelectorAll('.player-item');
  playerItems.forEach((item) => {
    item.addEventListener('click', () => {
      const playerName = item.querySelector('strong').innerText;
      alert(`${playerName}의 상세 프로필 및 전적 페이지로 이동합니다.`);
    });
  });

  // 4. 로그인 폼 이벤트
  const loginForm = document.getElementById('loginForm');
  loginForm.addEventListener('submit', (e) => {
    e.preventDefault();
    const userId = document.getElementById('userId').value;
    alert(`${userId}님, 배드민턴 스포츠 중계 포털에 로그인되었습니다.`);
    document.getElementById('userId').value = '';
    document.getElementById('userPw').value = '';
  });
});
